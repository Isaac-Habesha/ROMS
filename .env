# ROMS Environment Configuration
SECRET_KEY=django-insecure-roms-dev-key-change-in-production-2024
DEBUG=True

# Set to False to use PostgreSQL, True to use SQLite for quick local testing
USE_SQLITE=True

# PostgreSQL settings (active when USE_SQLITE=False)
DB_NAME=roms_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

